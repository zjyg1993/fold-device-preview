{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fold-device-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "dev": { "ip": "127.0.0.1", "port": 9218 },
  "rules": [
    { "type": "Text", "globs": ["**/proxy-runtime.js"], "fallthrough": false }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
